---
import Layout from '../layouts/Layout.astro';
import { projects, pages } from '../data/site';
import { posts } from '../data/writing';
---

<Layout {...pages['/projects/']}>
  <div class="row page-head">
    <div class="body"><h1>Projects</h1><p class="lede">Experiments you can play, and the tools behind them.</p></div>
  </div>
  {projects.map(project => {
    const essay = posts.find(post => post.frontmatter.project === project.id);
    return (
      <section class="row" id={project.id} aria-labelledby={`${project.id}-heading`}>
        <p class="margin">{project.category}</p>
        <div class="body">
          <h2 class="feature-title" id={`${project.id}-heading`}>{project.title}</h2>
          <p>{project.description}</p>
          <div class="actions">
            {project.demo ? <a class="button" href={project.demo} target="_blank" rel="noopener">Launch demo ↗</a> : <span class="planned">Coming soon</span>}
            {project.source && <a href={project.source} target="_blank" rel="noopener">View source ↗</a>}
            {essay && <a href={essay.url}>Read the essay</a>}
          </div>
        </div>
      </section>
    );
  })}
</Layout>
