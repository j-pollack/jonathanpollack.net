---
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import { posts } from '../data/writing';
import { projects } from '../data/site';

const latest = posts[0];
const featured = projects[0];
---

<Layout>
  <div class="home-grid">
    <Window title="about_me.txt" class="about-window">
      <h1>Hi there,<br />I’m Jonathan.</h1>
      <p class="intro">I write about stuff and build experiments you can poke at.</p>
      <p class="intro">Welcome to my little corner of the internet.</p>
      <div class="current-work">
        <h2 class="label">Currently exploring</h2>
        <p>AI control, oversight, and making the ideas easier to explore.</p>
      </div>
    </Window>
    <div class="home-stack">
      {latest && (
        <Window title="latest_essay.md" id="writing">
          <p class="label">From the notebook</p>
          <h2><a href={latest.url}>{latest.frontmatter.title}</a></h2>
          <p>{latest.frontmatter.description}</p>
          <div class="text-links"><a href={latest.url}>Read the essay →</a><a href="/writing/">All writing →</a></div>
        </Window>
      )}
      {featured && (
        <Window title={`${featured.id.replaceAll('-', '_')}.app`} id="projects">
          <p class="label">{featured.category}</p>
          <h2><a href={`/projects/#${featured.id}`}>{featured.title}</a></h2>
          <p>{featured.description}</p>
          <div class="text-links"><a href="/projects/">Explore projects →</a></div>
        </Window>
      )}
    </div>
  </div>
</Layout>
