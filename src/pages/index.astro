---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/portrait.jpg';
import { posts, shortDate } from '../data/writing';
import { projects } from '../data/site';

const featured = projects[0];
const featuredEssay = posts.find(post => post.frontmatter.project === featured?.id);
---

<Layout>
  <div class="row hero">
    <div class="margin hero-portrait">
      <Image src={portrait} alt="Illustrated portrait of Jonathan" width={384} loading="eager" />
    </div>
    <div class="body">
      <h1>Hi, I’m Jonathan</h1>
      <p class="lede">I write about stuff and build experiments you can play with.</p>
    </div>
  </div>
  {featured && (
    <section class="row" aria-labelledby="play-heading">
      <h2 class="margin" id="play-heading">Try the experiment</h2>
      <div class="body">
        <h3 class="feature-title">{featured.title}</h3>
        <p>{featured.description}</p>
        <div class="actions">
          {featured.demo && <a class="button" href={featured.demo} target="_blank" rel="noopener">Play {featured.title.toLowerCase()} ↗</a>}
          {featuredEssay && <a href={featuredEssay.url}>Read the essay behind it</a>}
        </div>
      </div>
    </section>
  )}
  <section class="row" aria-labelledby="writing-heading">
    <h2 class="margin" id="writing-heading">Writing</h2>
    <ul class="body entries">
      {posts.map(post => (
        <li class="entry">
          <h3><a href={post.url}>{post.frontmatter.title}</a></h3>
          <p>{post.frontmatter.description}</p>
          <p class="when"><time datetime={post.frontmatter.date}>{shortDate.format(new Date(post.frontmatter.date))}</time></p>
        </li>
      ))}
    </ul>
  </section>
</Layout>
