---
import Layout from '../../layouts/Layout.astro';
import Window from '../../components/Window.astro';
import { posts, shortDate } from '../../data/writing';
import { projects, pages } from '../../data/site';

const years = Object.entries(Object.groupBy(posts, post => post.frontmatter.date.slice(0, 4)))
  .sort(([a], [b]) => b.localeCompare(a));
---

<Layout {...pages['/writing/']}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Writing</span></nav>
  <Window title="writing/" class="archive">
    <div class="archive-intro"><h1>Writing</h1><p class="intro">Notes on AI, experiments, and other things on my mind.</p></div>
    {years.map(([year, entries]) => (
      <section aria-labelledby={`year-${year}`}>
        <h2 class="year" id={`year-${year}`}>{year}</h2>
        <ul class="entries">
          {entries!.map(post => {
            const project = projects.find(project => project.id === post.frontmatter.project);
            return (
              <li class="entry">
                <time datetime={post.frontmatter.date}>{shortDate.format(new Date(post.frontmatter.date))}</time>
                <div><h3><a href={post.url}>{post.frontmatter.title} →</a></h3><p>{post.frontmatter.description}</p>
                  {project && <p class="attached"><a href={`/projects/#${project.id}`}>↳ Companion experiment: {project.title} ↗</a></p>}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </Window>
</Layout>
