---
import Layout from '../../layouts/Layout.astro';
import { posts, shortDate } from '../../data/writing';
import { projects, pages } from '../../data/site';

const years = Object.entries(Object.groupBy(posts, post => post.frontmatter.date.slice(0, 4)))
  .sort(([a], [b]) => b.localeCompare(a));
---

<Layout {...pages['/writing/']}>
  <div class="row page-head">
    <div class="body"><h1>Writing</h1><p class="lede">Essays on AI control, oversight, and auditing frontier labs.</p></div>
  </div>
  {years.map(([year, entries]) => (
    <section class="row" aria-labelledby={`year-${year}`}>
      <h2 class="margin" id={`year-${year}`}>{year}</h2>
      <ul class="body entries">
        {entries!.map(post => {
          const project = projects.find(project => project.id === post.frontmatter.project);
          return (
            <li class="entry">
              <h3><a href={post.url}>{post.frontmatter.title}</a></h3>
              <p>{post.frontmatter.description}</p>
              <p class="when"><time datetime={post.frontmatter.date}>{shortDate.format(new Date(post.frontmatter.date))}</time>
                {project && <a href={`/projects/#${project.id}`}>Companion experiment: {project.title}</a>}
              </p>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Layout>
