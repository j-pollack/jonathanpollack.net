---
import '../styles/global.css';
import { github, contactEmail, pages, shareImagePath } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  publishedTime?: string;
}

const {
  title = pages['/'].title,
  description = pages['/'].description,
  image = shareImagePath(Astro.url.pathname),
  imageAlt = `${title} — ${description}`,
  publishedTime,
} = Astro.props;
const current = Astro.url.pathname.split('/')[1];
const canonical = new URL(`${Astro.url.pathname.replace(/\/$/, '')}/`, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Jonathan Pollack" />
    <meta property="og:type" content={publishedTime ? 'article' : 'website'} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    {image === shareImagePath(Astro.url.pathname) && <meta property="og:image:width" content="1200" />}
    {image === shareImagePath(Astro.url.pathname) && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {publishedTime && <meta property="article:author" content={new URL('/', Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="menubar">
      <a class="site-name" href="/" aria-label="JP’s computer">JP<span class="site-name-detail">’s computer</span></a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={current === '' ? 'page' : undefined}>Home</a>
        <a href="/writing/" aria-current={current === 'writing' ? 'page' : undefined}>Writing</a>
        <a href="/projects/" aria-current={current === 'projects' ? 'page' : undefined}>Projects</a>
        <a href={github} target="_blank" rel="noopener" aria-label="GitHub (opens in a new tab)">GitHub ↗</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">© {new Date().getUTCFullYear()} Jonathan Pollack / <a href={`mailto:${contactEmail}`}>Email me</a> / <a href={github} target="_blank" rel="noopener" aria-label="GitHub (opens in a new tab)">GitHub ↗</a></footer>
  </body>
</html>
